# ---------------------------------------------------------------------------
# Nidan Mother & Child Care - environment variables
# Copy this file to `.env` for local development. NEVER commit `.env`.
# On Hostinger, add the same variables in the Node.js Web App settings.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
# Port the Express server listens on (Hostinger injects its own PORT)
PORT=5000

# --- Database (MySQL / MariaDB) -------------------------------------------
# Local XAMPP defaults. On Hostinger use the values from hPanel > Databases.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nidan_crm
DB_USER=root
DB_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (e.g. 12h, 7d)
JWT_EXPIRES_IN=12h
# true when the site is served over HTTPS (always true in production)
COOKIE_SECURE=false

# Public URL of the site. Used for CORS in development and for links in emails.
# Local: http://localhost:5173   Production: https://nidanmotherandchildcare.com
CLIENT_URL=http://localhost:5173

# --- Deployment -------------------------------------------------------------
# true = run pending migrations automatically when the server starts (no SSH needed)
RUN_MIGRATIONS=false

# --- First super admin (created by `npm run db:seed`) -----------------------
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Email (Hostinger SMTP) -------------------------------------------------
# Leave SMTP_HOST empty in development to skip sending emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nidan Mother & Child Care <info@nidanmotherandchildcare.com>"
# Receives a notification for every new booking and contact enquiry
CLINIC_NOTIFY_EMAIL=info@nidanmotherandchildcare.com

# --- Uploads ----------------------------------------------------------------
# Folder for uploaded images and patient files. In production this MUST be
# outside the git-tracked app folder so a redeploy does not delete uploads,
# e.g. /home/<user>/nidan-uploads. Defaults to ./uploads (git-ignored).
UPLOAD_DIR=
